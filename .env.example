# App configuration
APP_PORT=8081
APP_REDIRECT_URI=https://your-app-domain/login/oauth2/code/{registrationId}

# Keycloak OAuth2 (auto-discovers other endpoints from issuer-uri)
KEYCLOAK_CLIENT_ID=sso-demo-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ISSUER_URI=https://keycloak-host/realms/sso-demo

# Microsoft Entra ID OAuth2 + SAML
ENTRA_CLIENT_ID=your-entra-app-id
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_TENANT_ID=your-tenant-id
ENTRA_SAML_APP_ID=${ENTRA_CLIENT_ID}

# App behavior
LOGIN_DEFAULT_REGISTRATION=keycloak
LOGIN_PROMPT=select_account

# Compliance (device trust)
COMPLIANCE_CLAIM=device_compliant
COMPLIANCE_VALUES=true,1,yes,compliant
COMPLIANCE_FAIL_OPEN=false
COMPLIANCE_DEBUG_FORCE=true
