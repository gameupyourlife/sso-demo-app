# Copy this file to `.env` and fill in the real values for your environment.

APP_PORT=8081
APP_REDIRECT_URI=https://your-domain.example/login/oauth2/code/{registrationId}

KEYCLOAK_CLIENT_ID=sso-demo-app
KEYCLOAK_CLIENT_SECRET=replace-with-your-keycloak-client-secret
KEYCLOAK_ISSUER_URI=https://keycloak.example.com/realms/sso-demo
KEYCLOAK_AUTH_URI=https://keycloak.example.com/realms/sso-demo/protocol/openid-connect/auth
KEYCLOAK_TOKEN_URI=https://keycloak.example.com/realms/sso-demo/protocol/openid-connect/token
KEYCLOAK_JWK_URI=https://keycloak.example.com/realms/sso-demo/protocol/openid-connect/certs
KEYCLOAK_USERINFO_URI=https://keycloak.example.com/realms/sso-demo/protocol/openid-connect/userinfo

ENTRA_CLIENT_ID=replace-with-your-entra-client-id
ENTRA_CLIENT_SECRET=replace-with-your-entra-client-secret
ENTRA_TENANT_ID=replace-with-your-tenant-id
ENTRA_AUTH_URI=https://login.microsoftonline.com/replace-with-your-tenant-id/oauth2/v2.0/authorize
ENTRA_TOKEN_URI=https://login.microsoftonline.com/replace-with-your-tenant-id/oauth2/v2.0/token
ENTRA_JWK_URI=https://login.microsoftonline.com/replace-with-your-tenant-id/discovery/v2.0/keys
ENTRA_USERINFO_URI=https://graph.microsoft.com/oidc/userinfo

ENTRA_SAML_APP_ID=replace-with-your-entra-client-id
ENTRA_SAML_METADATA_URI=https://login.microsoftonline.com/replace-with-your-tenant-id/federationmetadata/2007-06/federationmetadata.xml?appid=replace-with-your-entra-client-id

LOGIN_DEFAULT_REGISTRATION=keycloak
LOGIN_PROMPT=select_account
GRAPH_DEVICES_ENDPOINT=https://graph.microsoft.com/v1.0/me/ownedDevices?$select=id,deviceId,displayName,operatingSystem,operatingSystemVersion,trustType,isCompliant,isManaged
COMPLIANCE_CLAIM=device_compliant
COMPLIANCE_VALUES=true,1,yes,compliant
COMPLIANCE_FAIL_OPEN=false
COMPLIANCE_DEBUG_FORCE=

